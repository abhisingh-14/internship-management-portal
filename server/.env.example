# server/.env.example

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=internship_portal
# Optional: maximum size of the MySQL connection pool (defaults to 10 if unset)
DB_CONNECTION_LIMIT=10

# JWT access token — short-lived, used to authenticate normal API requests
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# JWT refresh token — longer-lived, used only against /auth/refresh-token
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor for password hashing
BCRYPT_SALT_ROUNDS=10

# Reserved for the File Upload component
MAX_RESUME_SIZE_MB=5
MAX_LOGO_SIZE_MB=2

# REQUIRED: Default admin account credentials (enforced on startup).
# The server will refuse to boot if either is missing, if ADMIN_PASSWORD is less
# than 8 characters, or if it matches a well-known weak default value.
ADMIN_EMAIL=admin@internshipportal.com
ADMIN_PASSWORD=SetAStrongUniquePasswordHere2026!

# Optional: logging level (defaults to 'info' in production, 'debug' in development)
# LOG_LEVEL=info